{
  "manifest_version": 3,
  "name": "Шахматный журнал",
  "version": "0.3.0",
  "description": "Личный журнал ежедневной шахматной практики для sebajun777.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lichess-training@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"], "optional": ["authenticationInfo"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "icons": { "48": "icons/training.svg", "96": "icons/training.svg" },
  "action": {
    "default_title": "Шахматный журнал",
    "default_popup": "ui/popup.html",
    "default_icon": "icons/training.svg"
  },
  "background": { "scripts": ["background.js"], "type": "module" },
  "optional_host_permissions": ["https://lichess.org/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
