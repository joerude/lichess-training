{
  "name": "lichess-training",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Personal Firefox training journal and addon learning project",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "inspect:dataset": "node scripts/inspect-dataset.js",
    "lint:addon": "web-ext lint --source-dir extension --warnings-as-errors --no-config-discovery",
    "build:addon": "web-ext build --source-dir extension --artifacts-dir dist --filename lichess-training-{version}.zip --overwrite-dest --no-config-discovery"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "web-ext": "10.7.0"
  }
}
